# Copy this file to .env and fill in any values you need to override.
# .env is gitignored and must NEVER be committed.

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Path for log files. Default is logs/ in the project root.
LOG_DIR=logs

# --- Storage ---
# Where downloaded PDFs go. Default data/raw.
RAW_DIR=data/raw

# Where parsed/chunked JSONL goes. Default data/processed.
PROCESSED_DIR=data/processed

# --- Qdrant (vector store) ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=engineering_codes_chunks

# --- Ollama (local LLM) ---
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# --- Embeddings / reranker (HuggingFace model IDs) ---
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Force embedder onto CPU (recommended on 8GB-VRAM machines where the LLM owns the GPU)
EMBED_DEVICE=cpu
RERANK_DEVICE=cpu

# --- Retrieval tuning ---
RETRIEVE_TOP_K=30
RERANK_TOP_K=6
MULTIHOP_MAX_HOPS=3

# --- Network exposure (LAN deployment only — defaults to localhost) ---
APP_HOST=127.0.0.1
APP_PORT=8501
